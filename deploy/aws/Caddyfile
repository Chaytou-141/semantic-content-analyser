{$DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 2MB
    }
    reverse_proxy app:8000 {
        # Overwrite client input. The app trusts this only from the exact proxy peer.
        header_up X-Demo-Client {remote_host}
        header_up X-Demo-Scheme {scheme}
    }
    header Strict-Transport-Security "max-age=31536000"
}
