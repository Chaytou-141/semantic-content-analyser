# Test tools are copied separately; production intentionally has no installer.
ARG APP_IMAGE=semantic-phase4d:app
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS tools
COPY requirements-linux.lock /test-constraints.txt
RUN pip install --no-cache-dir --target=/test-deps -c /test-constraints.txt pytest==9.1.1 httpx==0.28.1
FROM ${APP_IMAGE}
COPY --from=tools /test-deps /opt/test-deps
ENV PYTHONPATH=/opt/test-deps
