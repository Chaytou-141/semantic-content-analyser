* text=auto
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.tf text eol=lf
*.hcl text eol=lf
Dockerfile text eol=lf
deploy/caddy/go.mod text eol=lf
deploy/caddy/go.sum text eol=lf

